# Copiá este archivo como .env y completá los valores reales.
# El .env NO se sube a GitHub (está en .gitignore).

# Token que te da @BotFather al crear el bot (/newbot)
TELEGRAM_TOKEN=pega_aca_tu_token

# Clave de la API de Gemini (Google AI Studio -> Get API key)
GEMINI_API_KEY=pega_aca_tu_clave

# Modelo de Gemini a usar
GEMINI_MODEL=gemini-3.5-flash-lite
